{
  "schemaVersion": 1,
  "engineContract": "pdf-interaction-v1",
  "realSampleEnv": "RA_PDF_INTERACTION_SAMPLE",
  "realCases": [
    {
      "id": "ieee-two-column-math-dense-page",
      "page": 3,
      "queries": ["global power coefficient", "precoders"],
      "expected": {
        "mustNotCrossColumns": true,
        "requiresCharacterRange": true,
        "requiresPageRects": true,
        "minimumMathSegments": 5
      }
    }
  ],
  "syntheticCases": [
    {
      "id": "same-height-neighbour-column",
      "pageSize": { "width": 600, "height": 800 },
      "runs": [
        { "charStart": 0, "text": "left column", "rect": { "x": 40, "y": 100, "width": 180, "height": 16 } },
        { "charStart": 12, "text": "right p_k in C", "rect": { "x": 330, "y": 100, "width": 190, "height": 16 } }
      ],
      "selection": { "from": 12, "to": 25 },
      "expectedText": "right p_k in C"
    },
    {
      "id": "paragraph-around-display-equation",
      "pageSize": { "width": 600, "height": 800 },
      "runs": [
        { "charStart": 0, "text": "text above", "rect": { "x": 330, "y": 100, "width": 150, "height": 16 } },
        { "charStart": 10, "text": "x=sum p_k s_k", "rect": { "x": 355, "y": 130, "width": 120, "height": 24 } },
        { "charStart": 23, "text": "text below", "rect": { "x": 330, "y": 170, "width": 150, "height": 16 } }
      ],
      "selection": { "from": 23, "to": 32 },
      "expectedText": "text below"
    }
  ]
}

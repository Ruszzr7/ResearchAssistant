{
  "mcpServers": {
    "playwright": {
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@latest",
        "--headless",
        "--browser",
        "chromium",
        "--viewport-size",
        "1280x720",
        "--output-dir",
        "./playwright-mcp-output",
        "--output-mode",
        "file"
      ]
    }
  }
}

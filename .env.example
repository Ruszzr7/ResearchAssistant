MYSQL_DATABASE=research_assistant
MYSQL_USER=research
MYSQL_PASSWORD=change-this-database-password
MYSQL_ROOT_PASSWORD=change-this-root-password
RA_MASTER_KEY=replace-with-a-random-32-byte-secret
RA_CORS_ALLOWED_ORIGINS=http://localhost:8088
FRONTEND_PORT=8088

# Set true only during a verified one-time Flyway cutover of an existing
# Mission 12.1 database. Keep false for fresh deployments.
SPRING_FLYWAY_BASELINE_ON_MIGRATE=false
